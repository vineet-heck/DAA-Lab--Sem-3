#include <stdio.h>
#include <limits.h>

#define MAX_CITIES 16
#define INF 1e9 // Representing infinity safely for additions

int n;
int dist[MAX_CITIES][MAX_CITIES];
int dp[1 << MAX_CITIES][MAX_CITIES];

int min(int a, int b) {
    return (a < b) ? a : b;
}

int tsp(int mask, int pos) {
    if (mask == (1 << n) - 1) {
        return (dist[pos][0] != -1) ? dist[pos][0] : INF;
    }

    if (dp[mask][pos] != -1) {
        return dp[mask][pos];
    }

    int ans = INF;

    for (int nxt = 0; nxt < n; nxt++) {
        if ((mask & (1 << nxt)) == 0 && dist[pos][nxt] != -1) {
            int new_cost = dist[pos][nxt] + tsp(mask | (1 << nxt), nxt);
            ans = min(ans, new_cost);
        }
    }

    return dp[mask][pos] = ans;
}

int main() {
    if (scanf("%d", &n) != 1) return 0;

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (scanf("%d", &dist[i][j]) != 1) return 0;
            if (i == j && dist[i][j] < 0) {
                dist[i][j] = 0; 
            }
        }
    }

    for (int i = 0; i < (1 << n); i++) {
        for (int j = 0; j < n; j++) {
            dp[i][j] = -1;
        }
    }

    int optimal_cost = tsp(1, 0);

    if (optimal_cost >= INF) {
        printf("-1\n");
    } else {
        printf("%d\n", optimal_cost);
    }

    return 0;
}

